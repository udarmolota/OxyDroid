<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1) Set up an instance: add it, pick a GPU driver, install mods/DLC -->
    <group android:id="@+id/group_game" android:checkableBehavior="none">
        <item
            android:id="@+id/action_install_instance"
            android:icon="@drawable/mt_icon_add"
            android:title="@string/nav_new_instance" />
        <!-- Custom Vulkan driver: hidden, the native engine uses the phone's own driver. The id
             stays for LauncherActivity. -->
        <item
            android:id="@+id/action_custom_driver"
            android:icon="@drawable/mt_icon_settings"
            android:title="@string/nav_custom_driver"
            android:visible="false" />
        <!-- Mods (BepInEx): opens ModsFragment. The id is the old RimWorld "Install mod / DLC" one;
             that screen (InstallContentFragment) is no longer reachable from the menu. -->
        <!-- Hidden: Mods is in the bottom bar. The id stays for LauncherActivity. -->
        <item
            android:id="@+id/action_install_content"
            android:icon="@drawable/mt_icon_mods"
            android:title="@string/nav_mods"
            android:visible="false" />
        <!-- The game from GOG (DRM-free Linux installer), into an instance (GogDownloadFragment) -->
        <item
            android:id="@+id/action_gog"
            android:icon="@drawable/mt_icon_folder_open"
            android:title="@string/gog_dl_menu" />
        <!-- The Thunderstore catalog, the Steam download and Import / export are in the bottom bar
             (menu_bottom_nav.xml), so not here too. -->
    </group>

    <!-- 2) On-screen controls and the gamepad: everything about controls in one place. Actions that
         need an instance ask for it (or take the only one). -->
    <group android:id="@+id/group_controls" android:checkableBehavior="none">
        <item
            android:id="@+id/action_edit_controls"
            android:icon="@drawable/mt_icon_tune"
            android:title="@string/edit_controls" />
        <!-- Icon packs: pictures for the on-screen buttons, put on an instance's layout at once -->
        <item
            android:id="@+id/action_icon_packs"
            android:icon="@drawable/mt_icon_stack"
            android:title="@string/nav_icon_packs" />
        <!-- Gamepad mapping: hidden (the game reads its own controller input); the id stays for
             LauncherActivity. -->
        <item
            android:id="@+id/action_gamepad_mapper"
            android:icon="@drawable/mt_icon_settings"
            android:title="@string/gamepad_mapper_settings_btn"
            android:visible="false" />
    </group>

    <!-- 3) Steam: Workshop mods, cloud saves, achievements (the game download is the bottom bar's Game) -->
    <group android:id="@+id/group_store" android:checkableBehavior="none">
        <!-- Workshop mods with the player's Steam account, into an instance (WorkshopFragment) -->
        <item
            android:id="@+id/action_workshop"
            android:icon="@drawable/ic_steam"
            android:title="@string/nav_workshop" />
        <item
            android:id="@+id/action_cloud_saves"
            android:icon="@drawable/mt_icon_save"
            android:title="@string/nav_cloud_saves" />
        <!-- Steam achievements per instance (MultiplayerFragment; crossplay was the previous game's) -->
        <item
            android:id="@+id/action_multiplayer"
            android:icon="@drawable/mt_icon_group"
            android:title="@string/nav_multiplayer" />
    </group>

    <!-- 4) Settings (Import / export is the bottom bar's Import) -->
    <group android:id="@+id/group_data" android:checkableBehavior="none">
        <item
            android:id="@+id/action_settings"
            android:icon="@drawable/mt_icon_settings"
            android:title="@string/nav_settings" />
    </group>

    <!-- 5) Diagnostics -->
    <group android:id="@+id/group_files" android:checkableBehavior="none">
        <!-- "Manage storage" lives on each instance card's own menu (menu_game_instance.xml), where
             it acts on that instance — a global duplicate only made this drawer longer. -->
        <!-- One screen: by email (mail apps only) or saved to a file (BugReportFragment) -->
        <item
            android:id="@+id/action_bug_report"
            android:icon="@drawable/ic_bug_report"
            android:title="@string/nav_bug_report" />
    </group>

    <!-- The four external links (GitHub / X / Reddit / Support) are a row of icons in the drawer
         HEADER (nav_header_links.xml), not menu rows, to keep this list short. -->

</menu>
