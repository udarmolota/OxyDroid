<?xml version="1.0" encoding="utf-8"?>
<!-- One instance on the home screen, as SyxDroid's: the OxyDroid picture, a little see-through over
     a dark teal, a shade at the bottom, the instance's name and the game's version bottom left, the
     buttons bottom right. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="140dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#0B2A33">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.7"
            android:src="@drawable/instance_banner"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/instance_banner_shade" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/instance_item_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#99000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="ONI" />

                <!-- The game's version, from its own log once it has run (ReportInfo.shortGameVersion) -->
                <TextView
                    android:id="@+id/instance_item_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#99000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:text="Oxygen Not Included U60-764025" />
            </LinearLayout>

            <!-- Overflow, settings, play: kept snug (40dp each), white on the picture. -->
            <ImageButton
                android:id="@+id/instance_item_more"
                style="@style/AppTheme.ImageButton"
                android:layout_width="40dp"
                android:src="@drawable/mt_icon_more_vert"
                android:tint="#FFFFFF"
                android:contentDescription="@string/more_options" />

            <ImageButton
                android:id="@+id/instance_item_settings"
                style="@style/AppTheme.ImageButton"
                android:layout_width="40dp"
                android:src="@drawable/mt_icon_settings"
                android:tint="#FFFFFF"
                android:contentDescription="@string/nav_settings" />

            <ImageButton
                android:id="@+id/instance_item_launch"
                style="@style/AppTheme.ImageButton"
                android:layout_width="40dp"
                android:src="@drawable/mt_icon_play"
                android:tint="#FFFFFF"
                android:contentDescription="@string/launch" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
