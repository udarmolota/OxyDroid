<?xml version="1.0" encoding="utf-8"?>
<!-- Mods of one instance (OniModsFragment): the game's own list in load order, a switch, up / down and
     delete per mod, and the button that installs mods from a zip right here. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/install_content_instance"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/sp_oni_mods_instance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- A filled button in the launcher's colour: the one action of this screen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_oni_mods_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/oni_mods_import"
            android:textColor="@color/rd_on_primary"
            app:backgroundTint="@color/rd_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.7"
            android:text="@string/oni_mods_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_oni_mods_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/oni_mods_empty"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_oni_mods_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
