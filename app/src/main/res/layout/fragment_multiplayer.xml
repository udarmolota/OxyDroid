<?xml version="1.0" encoding="utf-8"?>
<!-- Multiplayer for one instance (MultiplayerFragment): pick the instance, switch crossplay on or off.
     Crossplay runs on the native engine only; for another engine the switch is greyed out with a note. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

            <TextView
                style="@style/AppTheme.CardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_packs_instance"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/sp_mp_instance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Crossplay (the previous game's PlayFab login): hidden, with its notes. The ids stay
                 for MultiplayerFragment. -->
            <Switch
                android:id="@+id/sw_crossplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="14sp"
                android:visibility="gone"
                android:text="@string/crossplay_label" />

            <TextView
                android:id="@+id/tv_mp_native_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                android:text="@string/crossplay_native_only" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:alpha="0.7"
                android:visibility="gone"
                android:text="@string/crossplay_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:alpha="0.7"
                android:visibility="gone"
                android:text="@string/crossplay_servers_note" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Steam achievements for the same instance (the switch follows the instance picked above). -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

            <TextView
                style="@style/AppTheme.CardHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_steam_achievements"
                android:layout_marginBottom="6dp" />

            <!-- The old "sign in before each launch" switch: hidden, the sync is the button below. The
                 id stays for MultiplayerFragment. -->
            <Switch
                android:id="@+id/sw_steam_achievements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:visibility="gone"
                android:text="@string/steam_achievements_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:alpha="0.7"
                android:text="@string/steam_achievements_hint" />

            <!-- What the last sign-in brought (SteamAchievementList); filled by MultiplayerFragment. -->
            <TextView
                android:id="@+id/tv_achievements_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp" />

            <!-- Sign in, exchange, sign out: no game launch needed. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sync_achievements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/steam_achievements_sync"
                android:textColor="@color/rd_on_primary"
                app:backgroundTint="@color/rd_primary" />

            <Button
                android:id="@+id/btn_my_achievements"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/steam_achievements_show" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
